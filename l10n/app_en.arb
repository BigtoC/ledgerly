  "settingsSplashDisplayTextHint": "Use {dateToken} and {daysToken} as placeholders",
  "@settingsSplashDisplayTextHint": {
    "description": "Settings plan §6. Hint text under the splash display-text field explaining the template variables. The placeholders are named `dateToken` / `daysToken` (not `date` / `days`) because the call site passes the literal strings '{date}' and '{days}' as arguments — these are the actual MessageFormat-looking tokens that DateHelpers.applySplashTemplateSegments substitutes. gen_l10n itself cannot embed literal { / } in a plain message, so the indirection through real placeholders is how the hint advertises the correct token form.",
    "placeholders": {
      "dateToken": { "type": "String" },
      "daysToken": { "type": "String" }
    }
  },

